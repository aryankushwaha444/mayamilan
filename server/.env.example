PORT=5000

# Database
MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=dating_portal

# Environment
NODE_ENV=development

# URLs
CLIENT_URL=http://localhost:5173
SITE_URL=https://mayamilan.vercel.app
SECURITY_EMAIL=rupnarayan444@gmail.com

# JWT Secrets (paste generated values)
JWT_ACCESS_SECRET_CURRENT=<paste-from-step-1>
JWT_ACCESS_SECRET_PREVIOUS=
JWT_REFRESH_SECRET_CURRENT=<paste-from-step-1>
JWT_REFRESH_SECRET_PREVIOUS=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ✅ CRITICAL: API Signing (server-side)
API_SECRET=<paste-from-step-1>

# Cloudinary (get from cloudinary.com dashboard)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (Brevo - you have this)
BREVO_API_KEY=xkeysib-...
BREVO_SENDER_EMAIL=rupnarayan444@gmail.com

# Google OAuth (get from console.cloud.google.com)
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Push Notifications (generate: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=rupnarayan444@gmail.com

# Security
TURNSTILE_SITE_KEY=your_site_key
TURNSTILE_SECRET=your_secret
TURNSTILE_ENABLED=false

# ✅ CRITICAL: TOTP Encryption (paste from step 1)
TOTP_ENCRYPTION_KEY=<paste-from-step-1>

# IP Reputation
ABUSEIPDB_KEY=your_abuseipdb_key
ABUSEIPDB_ENABLED=true
ABUSEIPDB_BLOCK_THRESHOLD=75

# Redis (optional)
# REDIS_URL=redis://localhost:6379