# Database
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/dating_portal?retryWrites=true&w=majority
DB_NAME=dating_portal

# URLs
CLIENT_URL=https://your-app.vercel.app
SITE_URL=https://your-app.vercel.app
SECURITY_EMAIL=security@yourdomain.com

# JWT Secrets (generate 64-char hex strings)
JWT_ACCESS_SECRET_CURRENT=paste_64_char_hex_here
JWT_ACCESS_SECRET_PREVIOUS=
JWT_REFRESH_SECRET_CURRENT=paste_64_char_hex_here
JWT_REFRESH_SECRET_PREVIOUS=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (Brevo)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=noreply@yourdomain.com

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://your-api.onrender.com/api/auth/google/callback

# Push Notifications
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=mailto:admin@yourdomain.com

# Security
TURNSTILE_SECRET=your_turnstile_secret
TURNSTILE_ENABLED=true
TOTP_ENCRYPTION_KEY=your_32_byte_hex_key

# IP Reputation
ABUSEIPDB_KEY=your_abuseipdb_key
ABUSEIPDB_ENABLED=true
ABUSEIPDB_BLOCK_THRESHOLD=75

# Optional: Redis (if using)
REDIS_URL=redis://your-redis-url